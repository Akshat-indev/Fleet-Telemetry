# Copy to .env and adjust if needed. Never commit .env.
# Defaults below match docker-compose.yml and work out of the box locally.
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# Used when running the API, tests, or scripts outside Docker (host-side).
# Inside Docker Compose the API uses the "db" service hostname instead.
DATABASE_URL=postgresql+psycopg://fleet:fleet@localhost:5432/fleet

# Alert engine tunables (optional — defaults shown, uncomment to override).
# OFFLINE_AFTER_SECONDS=90
# OFFLINE_CHECK_INTERVAL_SECONDS=15
# DISCHARGE_DROP_PCT=8
# DISCHARGE_WINDOW_SECONDS=300
# GEOFENCE_POLYGON=[[12.8,79.9],[13.3,79.9],[13.3,80.5],[12.8,80.5]]

# Device authentication / rate limiting (optional — defaults shown).
# AUTH_TIMESTAMP_WINDOW_SECONDS=300
# RATE_LIMIT_CAPACITY=120
# RATE_LIMIT_REFILL_PER_SECOND=20.0
# Device-group credentials are NOT configured here: provision them with
#   docker compose exec api python -m app.manage create-group --name <name>
# The generated secret is printed once and stored in the database.
